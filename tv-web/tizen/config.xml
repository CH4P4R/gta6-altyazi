<!-- required_version 2.4: 2016 Samsung TV'ler (Tizen 2.4) de kurabilsin; yeni TV'ler daha düşük sürüm isteyen paketi
     de kurar. Issue #71'de 2016 model 40KU7000'de (Tizen 2.4) doğrulandı. İzinlerin hepsi "public" düzeyde; Samsung'un
     herkese verdiği geliştirici sertifikası yeter. Sayfa ES5 ile yazıldığı için eski tarayıcılarda da çalışır. -->
<!-- required_version 3.0: 2017 Samsung TV'ler (Tizen 3.0) de kurabilsin; yeni TV'ler daha düşük sürüm isteyen paketi
     de kurar. İzinlerin hepsi "public" düzeyde; Samsung'un herkese verdiği geliştirici sertifikası yeter. Sayfa ES5 ile
     yazıldığı için Tizen 3.0'ın tarayıcısında (Chromium 47) da çalışır. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/CH4P4R/gta6-altyazi" version="0.4.0" viewmodes="maximized">
    <tizen:application id="GTA6Altyzi.GTA6Altyazi" package="GTA6Altyzi" required_version="2.4"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>GTA6 Altyazı</name>
    <author>GTA6 Altyazı</author>
    <license>AGPL-3.0-only</license>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.get"/>
    <tizen:privilege name="http://tizen.org/privilege/power"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
